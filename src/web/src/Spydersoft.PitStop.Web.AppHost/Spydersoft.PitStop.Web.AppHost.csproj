<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.2.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <AssemblyName>Spydersoft.PitStop.Web.AppHost</AssemblyName>
    <RootNamespace>Spydersoft.PitStop.Web.AppHost</RootNamespace>
    <UserSecretsId>pitstop-web-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spydersoft.PitStop.Frontend\Spydersoft.PitStop.Frontend.csproj" />
  </ItemGroup>

</Project>
