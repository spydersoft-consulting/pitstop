  "components": {
    "schemas": {
      "CreateFillUpRequest": {
        "type": "object",
        "properties": {
          "filledAt": {
            "type": "string",
            "format": "date-time"
          },
          "odometerReading": {
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "gallonsAdded": {
            "minimum": 0.001,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "fuelGrade": {
            "type": [
              "null",
              "string"
            ]
          },
          "pricePerGallon": {
            "minimum": 0.001,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalCost": {
            "minimum": 0.001,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "isFullFillUp": {
            "type": "boolean"
          },
          "locationId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CreateLocationRequest"
              }
            ]
          },
          "notes": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateLocationRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "address": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "googlePlaceId": {
            "maxLength": 255,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateVehicleRequest": {
        "required": [
          "name",
          "make",
          "model"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "year": {
            "maximum": 2100,
            "minimum": 1900,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "make": {
            "maxLength": 50,
            "type": "string"
          },
          "model": {
            "maxLength": 50,
            "type": "string"
          },
          "trim": {
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ]
          },
          "initialOdometer": {
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "tankCapacityGallons": {
            "maximum": 200,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "FillUpDto": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "vehicleId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "filledAt": {
            "type": "string",
            "format": "date-time"
          },
          "odometerReading": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "gallonsAdded": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "fuelGrade": {
            "type": "string"
          },
          "pricePerGallon": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalCost": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "isFullFillUp": {
            "type": "boolean"
          },
