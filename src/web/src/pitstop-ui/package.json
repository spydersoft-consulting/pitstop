{
  "name": "pitstop-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:fix": "eslint --report-unused-disable-directives --max-warnings 0 --fix && prettier --write",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0 && prettier",
    "preview": "vite preview",
    "test-ui": "vitest --ui --coverage",
    "test": "vitest --reporter=verbose",
    "test-ci": "vitest run --reporter junit --coverage",
    "api:spec": "curl -s -o pitstop.json http://localhost:8080/openapi/v1.json",
    "api:generate": "openapi-ts",
    "api:update": "yarn api:spec && yarn api:generate"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hey-api/client-axios": "^0.9.1",
    "@microsoft/signalr": "^10.0.11",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "primeicons": "^8.0.2",
    "primereact": "^10.9.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.4",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.97.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "yarn@4.9.2"
}
