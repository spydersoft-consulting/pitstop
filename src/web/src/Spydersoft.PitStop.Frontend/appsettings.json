{
  "AddressLookup": {
    "GooglePlacesApiKey": "",
    "Provider": "none"
  },
  "AllowedHosts": "*",
  "OidcProxySettings": {
    "Oidc": {
      "Authority": "https://auth.mattgerega.net",
      "DisablePushedAuthorization": true,
      "Scopes": [
        "openid",
        "profile",
        "email",
        "offline_access",
        "pitstop:read",
        "pitstop:write",
        "notification:read",
        "notification:write"
      ]
    },
    "ReverseProxy": {
      "Clusters": {
        "auditApi": {
          "Destinations": {
            "destination1": {
              "Address": "http://pitstop-audit-api/"
            }
          }
        },
        "notificationApi": {
          "Destinations": {
            "destination1": {
              "Address": "http://notification-api/"
            }
          }
        },
        "notificationHub": {
          "Destinations": {
            "destination1": {
              "Address": "http://notification-hub/"
            }
          }
        },
        "pitstopApi": {
          "Destinations": {
            "destination1": {
              "Address": "http://data-api/"
            }
          }
        }
      },
      "Routes": {
        "api": {
          "AllowAnonymous": false,
          "ClusterId": "pitstopApi",
          "Match": {
            "Path": "/pitstop/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/pitstop"
            }
          ]
        },
        "audit-api": {
          "AllowAnonymous": false,
          "ClusterId": "auditApi",
          "Match": {
            "Path": "/audit/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/audit"
            }
          ]
        },
        "notification": {
          "AllowAnonymous": false,
          "ClusterId": "notificationApi",
          "Match": {
            "Path": "/notification/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/notification"
            }
          ]
        },
        "notification-hub": {
          "AllowAnonymous": false,
          "ClusterId": "notificationHub",
          "Match": {
            "Path": "/notification-hub/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/notification-hub"
            }
          ]
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Telemetry": {
    "ActivitySourceName": "pitstop.web",
    "Log": {
      "Type": "otlp"
    },
    "MeterName": "pitstop.web",
    "Metrics": {
      "Type": "otlp"
    },
    "ServiceName": "pitstop.web",
    "Trace": {
      "Type": "otlp"
    }
  }
}
