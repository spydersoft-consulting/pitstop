{
  "AllowedHosts": "*",
  "OidcProxySettings": {
    "Oidc": {
      "Authority": "https://auth.mattgerega.net",
      "DisablePushedAuthorization": true,
      "Scopes": ["openid", "profile", "email", "pitstop:read", "pitstop:write"]
    },
    "ReverseProxy": {
      "Clusters": {
        "auditApi": {
          "Destinations": {
            "destination1": {
              "Address": "http://pitstop-audit-api/"
            }
          }
        },
        "pitstopApi": {
          "Destinations": {
            "destination1": {
              "Address": "http://data-api/"
            }
          }
        }
      },
      "Routes": {
        "api": {
          "AllowAnonymous": false,
          "ClusterId": "pitstopApi",
          "Match": {
            "Path": "/pitstop/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/pitstop"
            }
          ]
        },
        "audit-api": {
          "AllowAnonymous": false,
          "ClusterId": "auditApi",
          "Match": {
            "Path": "/audit/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/audit"
            }
          ]
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Telemetry": {
    "ActivitySourceName": "pitstop.web",
    "Log": {
      "Type": "otlp"
    },
    "MeterName": "pitstop.web",
    "Metrics": {
      "Type": "otlp"
    },
    "ServiceName": "pitstop.web",
    "Trace": {
      "Type": "otlp"
    }
  }
}
