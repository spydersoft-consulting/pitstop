<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<UserSecretsId>a1b2c3d4-e5f6-7890-abcd-ef1234567890</UserSecretsId>
		<SpaRoot>..\pitstop-ui\</SpaRoot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OidcProxy.Net.OpenIdConnect" />
		<PackageReference Include="Spydersoft.Platform.Hosting" />
	</ItemGroup>

	<!--
	Replaces the old pitstop-ui.esproj ProjectReference (the JS project
	system's build integration). esproj is deprecated/poorly supported;
	build the SPA directly with yarn instead and fold its output into this
	project's own build/publish output.
	-->
	<Target Name="BuildSpa" BeforeTargets="Build">
		<Exec Command="yarn install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
		<Exec Command="yarn build" WorkingDirectory="$(SpaRoot)" />
	</Target>

	<!--
	`dotnet run`/`dotnet build` only trigger BuildSpa (dist/ on disk). MapFallbackToFile in
	Program.cs needs wwwroot/index.html, which used to only get populated by a publish-only
	target, leaving wwwroot empty for anything driven by `dotnet run` (notably the Playwright
	suites' AppHost webServer): every deep-linked SPA route 404'd with an empty body on a clean
	checkout. It only worked locally by accident, riding on a leftover wwwroot/ from an earlier
	`dotnet publish` in the same working tree.

	Copying into the physical wwwroot/ here means the Web SDK's own default
	`Content Include="wwwroot/**"` item now picks these files up for publish automatically:
	a separate publish-time target that also injected dist/** into wwwroot would double up and
	fail with NETSDK1152 (duplicate publish output files), so this replaces that target rather
	than sitting alongside it. CI's "no build" publish step relies on this Build-time copy having
	already happened earlier in the same job (via `dotnet build`); see pipeline-ci.yml.
	-->
	<Target Name="CopySpaToWwwroot" AfterTargets="Build">
		<ItemGroup>
			<SpaBuildFiles Include="$(SpaRoot)dist\**" />
		</ItemGroup>
		<Copy SourceFiles="@(SpaBuildFiles)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
