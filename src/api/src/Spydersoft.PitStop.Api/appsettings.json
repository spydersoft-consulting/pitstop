{
  "AllowedHosts": "*",
  "Auth": {
    "Audience": "pitstop-data-api",
    "Authority": "https://auth.mattgerega.net"
  },
  "FileStore": {
    "BaseUrl": "https://filestore.mattgerega.net",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "filestore:read filestore:write",
    "TokenEndpoint": ""
  },
  "HealthCheck": {
    "LiveTags": [],
    "ReadyTags": [],
    "StartupTags": []
  },
  "Nhtsa": {
    "BaseUrl": "https://api.nhtsa.gov/",
    "CacheDurationMinutes": 1440,
    "VinDecodeCacheDurationMinutes": 43200,
    "VpicBaseUrl": "https://vpic.nhtsa.dot.gov/api/"
  },
  "Notification": {
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "HubUrl": "",
    "Scope": "notification:write",
    "TokenEndpoint": ""
  },
  "RecallCheck": {
    "IntervalHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Telemetry": {
    "ActivitySourceName": "pitstop.data",
    "Log": {
      "Type": "otlp"
    },
    "MeterName": "pitstop.data",
    "Metrics": {
      "Type": "otlp"
    },
    "ServiceName": "pitstop.data",
    "Trace": {
      "Type": "otlp"
    }
  }
}
